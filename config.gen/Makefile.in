ccextratorwin/comskip-myth.$(OBJEXT): ccextratorwin/$(am__dirstamp) \
	ccextratorwin/$(DEPDIR)/$(am__dirstamp)

comskip$(EXEEXT): $(comskip_OBJECTS) $(comskip_DEPENDENCIES) $(EXTRA_comskip_DEPENDENCIES) 
	@rm -f comskip$(EXEEXT)
	$(AM_V_CCLD)$(comskip_LINK) $(comskip_OBJECTS) $(comskip_LDADD) $(LIBS)
